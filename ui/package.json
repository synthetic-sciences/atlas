{
  "name": "@synsci/atlas-ui",
  "version": "0.1.0",
  "description": "Embeddable Atlas research graph components for React",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "graph.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graph.css": "./graph.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthetic-sciences/atlas.git",
    "directory": "ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@xyflow/react": "^12.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dagre": "^0.8.5",
    "lucide-react": "^1.7.0",
    "react-router-dom": "^7.1.0",
    "zustand": "^5.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json"
  }
}

{
  "name": "@synsci/atlas-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Atlas graph engine, CLI, SDK, and unchanged graph UI.",
  "scripts": {
    "test:cli": "node --test cli/tests/*.test.mjs",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "typecheck": "tsc --project ui/tsconfig.json --noEmit",
    "test": "npm run test:cli && npm run test:ui",
    "test:sdk": "node --test sdk/tests/*.test.mjs",
    "build:ui": "npm run build --workspace ui",
    "build:landing": "npm --prefix landing run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/dagre": "^0.7.52",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthetic-sciences/atlas.git"
  },
  "license": "Apache-2.0",
  "workspaces": [
    "cli",
    "ui",
    "sdk"
  ]
}

{
  "name": "@synsci/atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Atlas graph engine, CLI, SDK, and unchanged graph UI.",
  "bin": {
    "atlas": "cli/bin/atlas.mjs"
  },
  "exports": {
    "./ui/*": "./ui/src/*",
    "./ui": "./ui/src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "cli/bin",
    "cli/src",
    "ui/src",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "test:cli": "node --test cli/tests/*.test.mjs",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "typecheck": "tsc --project ui/tsconfig.json --noEmit",
    "test": "npm run test:cli && npm run test:ui",
    "prepublishOnly": "node -e \"console.error('This private graph package is not a public release.'); process.exit(1)\""
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@xyflow/react": "^12.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dagre": "^0.8.5",
    "lucide-react": "^1.7.0",
    "react-router-dom": "^7.1.0",
    "zustand": "^5.0.0",
    "open": "^10.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/dagre": "^0.7.52",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthetic-sciences/atlas.git"
  },
  "license": "UNLICENSED"
}
